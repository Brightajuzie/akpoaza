generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 String             @id @default(uuid())
  email              String             @unique
  passwordHash       String?
  name               String
  role               Role               @default(CUSTOMER)
  provider           AuthProvider       @default(LOCAL)
  providerId         String?
  profileImage       String?
  phone              String?
  address            String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  currentLat         Float?
  currentLng         Float?
  latitude           Float?
  longitude          Float?
  specialty          String?
  bvnHash            String?
  kycReferenceId     String?
  kycSubmittedAt     DateTime?
  opayPhone          String?
  rejectionReason    String?
  verificationStatus VerificationStatus @default(UNVERIFIED)
  licensePlate       String?
  riderStatus        String?            @default("OFFLINE")
  vehicleType        String?
  country            String?            @default("Nigeria")
  currency           String?            @default("NGN")
  bookings           Booking[]          @relation("CustomerBookings")
  jobs               Booking[]          @relation("HandymanJobs")
  escrows            Escrow[]           @relation("ProviderEscrows")
  deliveries         Order[]            @relation("RiderDeliveries")
  orders             Order[]
  riderParcels       ParcelDelivery[]   @relation("RiderParcels")
  customerParcels    ParcelDelivery[]   @relation("CustomerParcels")
  products           Product[]          @relation("VendorProducts")
  reviewsGiven       Review[]           @relation("ReviewAuthor")
  reviewsReceived    Review[]           @relation("ReviewHandyman")
  wallet             Wallet?
}

model Product {
  id          String      @id @default(uuid())
  name        String
  description String
  price       Float
  stock       Int         @default(0)
  imageUrl    String?
  category    String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  vendorId    String?
  featured    Boolean     @default(false)
  orderItems  OrderItem[]
  vendor      User?       @relation("VendorProducts", fields: [vendorId], references: [id])
  reviews     Review[]    @relation("ReviewProduct")
}

model Order {
  id              String          @id @default(uuid())
  userId          String
  totalAmount     Float
  status          OrderStatus     @default(PENDING)
  paymentProvider PaymentProvider @default(NONE)
  paymentRef      String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  amountPaid      Float           @default(0.0)
  isSplitPayment  Boolean         @default(false)
  riderId         String?
  deliveryAddress String?
  currency        String          @default("NGN")
  escrows         Escrow[]
  rider           User?           @relation("RiderDeliveries", fields: [riderId], references: [id])
  user            User            @relation(fields: [userId], references: [id])
  items           OrderItem[]
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  productId String
  quantity  Int     @default(1)
  price     Float
  order     Order   @relation(fields: [orderId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
}

model Service {
  id          String    @id @default(uuid())
  name        String
  description String
  category    String
  basePrice   Float
  imageUrl    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  featured    Boolean   @default(false)
  bookings    Booking[]
  reviews     Review[]  @relation("ReviewService")
}

model Booking {
  id                String   @id @default(uuid())
  customerId        String
  handymanId        String?
  serviceId         String
  status            String   @default("PENDING")
  scheduledAt       DateTime
  address           String
  totalPrice        Float
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  handymanLatitude  Float?
  handymanLongitude Float?
  latitude          Float?
  longitude         Float?
  amountPaid        Float    @default(0.0)
  isSplitPayment    Boolean  @default(false)
  currency          String   @default("NGN")
  customer          User     @relation("CustomerBookings", fields: [customerId], references: [id])
  handyman          User?    @relation("HandymanJobs", fields: [handymanId], references: [id])
  service           Service  @relation(fields: [serviceId], references: [id])
  escrows           Escrow[]
}

model Review {
  id         String   @id @default(uuid())
  authorId   String
  productId  String?
  serviceId  String?
  handymanId String?
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
  author     User     @relation("ReviewAuthor", fields: [authorId], references: [id])
  handyman   User?    @relation("ReviewHandyman", fields: [handymanId], references: [id])
  product    Product? @relation("ReviewProduct", fields: [productId], references: [id])
  service    Service? @relation("ReviewService", fields: [serviceId], references: [id])
}

model AppSetting {
  key   String @id
  value String
}

model Notification {
  id          String   @id @default(uuid())
  userId      String
  title       String
  body        String
  type        String
  read        Boolean  @default(false)
  referenceId String?
  createdAt   DateTime @default(now())
}

model Wallet {
  id             String        @id @default(uuid())
  userId         String        @unique
  balance        Float         @default(0.0)
  pendingBalance Float         @default(0.0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  transactions   Transaction[]
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  withdrawals    Withdrawal[]
}

model Transaction {
  id          String   @id @default(uuid())
  walletId    String
  amount      Float
  type        String
  status      String   @default("COMPLETED")
  description String?
  referenceId String?
  createdAt   DateTime @default(now())
  wallet      Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
}

model PromoSlide {
  id        String   @id @default(uuid())
  imageUrl  String
  caption   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Escrow {
  id               String          @id @default(uuid())
  bookingId        String?
  orderId          String?
  providerId       String
  amount           Float
  commissionAmount Float
  providerAmount   Float
  status           String          @default("HELD")
  autoReleaseAt    DateTime?
  releasedAt       DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  parcelDeliveryId String?
  booking          Booking?        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  order            Order?          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  parcelDelivery   ParcelDelivery? @relation(fields: [parcelDeliveryId], references: [id], onDelete: Cascade)
  provider         User            @relation("ProviderEscrows", fields: [providerId], references: [id], onDelete: Cascade)
}

model Withdrawal {
  id            String   @id @default(uuid())
  walletId      String
  amount        Float
  fee           Float
  netAmount     Float
  status        String   @default("PENDING")
  payoutMethod  String   @default("BANK_TRANSFER")
  accountNumber String?
  bankName      String?
  bankCode      String?
  instant       Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  wallet        Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
}

model ParcelDelivery {
  id                String          @id @default(uuid())
  userId            String
  riderId           String?
  pickupAddress     String
  dropoffAddress    String
  pickupLat         Float
  pickupLng         Float
  dropoffLat        Float
  dropoffLng        Float
  parcelDescription String?
  totalAmount       Float
  status            OrderStatus     @default(PENDING)
  paymentProvider   PaymentProvider @default(NONE)
  paymentRef        String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  currency          String          @default("NGN")
  escrows           Escrow[]
  rider             User?           @relation("RiderParcels", fields: [riderId], references: [id])
  user              User            @relation("CustomerParcels", fields: [userId], references: [id])
}

enum Role {
  CUSTOMER
  HANDYMAN
  ADMIN
  VENDOR
  RIDER
}

enum AuthProvider {
  LOCAL
  GOOGLE
  APPLE
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentProvider {
  STRIPE
  PAYSTACK
  FLUTTERWAVE
  NONE
  OPAY
}

enum VerificationStatus {
  UNVERIFIED
  PENDING_REVIEW
  VERIFIED
  REJECTED
}
